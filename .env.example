# Optional for the demo. Set all four to enable database-backed content and owner access.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OWNER_USER_ID=

# Optional until the owner needs to upload media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional until the owner wants notifications for stored enquiries.
RESEND_API_KEY=
ENQUIRY_FROM=
ENQUIRY_TO=

# Set to the preferred HTTPS origin for public SEO metadata when using a custom domain.
SITE_URL=
